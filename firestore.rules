rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1: Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function parentUserExists(userId) {
      return exists(/databases/$(database)/documents/users/$(userId));
    }

    // Validation Blueprint: UserProfile
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'provider', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'uid',
          'displayName',
          'email',
          'photoURL',
          'bio',
          'roleTitle',
          'provider',
          'themePreset',
          'language',
          'promptCount',
          'appBuildCount',
          'mediaGenCount',
          'createdAt',
          'updatedAt'
        ]) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.uid == request.auth.uid &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 120 &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
        (!('bio' in data) || (data.bio is string && data.bio.size() <= 240)) &&
        (!('roleTitle' in data) || (data.roleTitle is string && data.roleTitle.size() <= 60)) &&
        data.provider is string && data.provider.size() <= 20 && data.provider in ['google', 'github', 'email'] &&
        (!('themePreset' in data) || (data.themePreset is string && data.themePreset.size() <= 30 && data.themePreset in ['neon_dark', 'midnight_blue', 'minimal_mono', 'solar_light'])) &&
        (!('language' in data) || (data.language is string && data.language.size() <= 20 && data.language in ['english', 'urdu', 'roman'])) &&
        (!('promptCount' in data) || (data.promptCount is number && data.promptCount >= 0)) &&
        (!('appBuildCount' in data) || (data.appBuildCount is number && data.appBuildCount >= 0)) &&
        (!('mediaGenCount' in data) || (data.mediaGenCount is number && data.mediaGenCount >= 0)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Validation Blueprint: UserProject
    function isValidUserProject(data, userId, projectId) {
      return data.keys().hasAll(['id', 'ownerId', 'numericId', 'title', 'idea', 'progress', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'ownerId', 'numericId', 'title', 'idea', 'progress', 'status', 'createdAt', 'updatedAt']) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.id == projectId &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId == request.auth.uid &&
        data.ownerId == userId &&
        data.numericId is number && data.numericId >= 1 &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
        data.idea is string && data.idea.size() <= 2000 &&
        data.progress is string && data.progress.size() <= 1000 &&
        data.status is string && data.status.size() <= 20 && data.status in ['active', 'paused', 'complete'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Validation Blueprint: UserConversation
    function isValidUserConversation(data, userId, conversationId) {
      return data.keys().hasAll(['id', 'ownerId', 'numericId', 'projectId', 'title', 'lastMessagePreview', 'messageCount', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'ownerId', 'numericId', 'projectId', 'title', 'lastMessagePreview', 'messageCount', 'createdAt', 'updatedAt']) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.id == conversationId &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId == request.auth.uid &&
        data.ownerId == userId &&
        data.numericId is number && data.numericId >= 1 &&
        data.projectId is number && data.projectId >= 0 &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 140 &&
        data.lastMessagePreview is string && data.lastMessagePreview.size() <= 500 &&
        data.messageCount is number && data.messageCount >= 0 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Validation Blueprint: UserKnowledgeDoc
    function isValidUserKnowledgeDoc(data, userId, docId) {
      return data.keys().hasAll(['id', 'ownerId', 'numericId', 'projectId', 'name', 'mimeType', 'content', 'createdAt']) &&
        data.keys().hasOnly(['id', 'ownerId', 'numericId', 'projectId', 'name', 'mimeType', 'content', 'createdAt']) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.id == docId &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId == request.auth.uid &&
        data.ownerId == userId &&
        data.numericId is number && data.numericId >= 1 &&
        data.projectId is number && data.projectId >= 1 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 160 &&
        data.mimeType is string && data.mimeType.size() >= 1 && data.mimeType.size() <= 100 &&
        data.content is string && data.content.size() <= 100000 &&
        data.createdAt is timestamp;
    }

    // Validation Blueprint: UserArtifact
    function isValidUserArtifact(data, userId, artifactId) {
      return data.keys().hasAll(['id', 'ownerId', 'kind', 'title', 'description', 'createdAt']) &&
        data.keys().hasOnly(['id', 'ownerId', 'kind', 'title', 'description', 'htmlCode', 'createdAt']) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.id == artifactId &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId == request.auth.uid &&
        data.ownerId == userId &&
        data.kind is string && data.kind.size() <= 20 && data.kind in ['app', 'image', 'video', 'audio'] &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
        data.description is string && data.description.size() <= 1000 &&
        (!('htmlCode' in data) || (data.htmlCode is string && data.htmlCode.size() <= 150000)) &&
        data.createdAt is timestamp;
    }

    // User Profiles Collection (PII Isolated per Owner)
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isVerified() &&
        isOwner(userId) &&
        isValidId(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isVerified() &&
        isOwner(userId) &&
        isValidId(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'email',
          'photoURL',
          'bio',
          'roleTitle',
          'provider',
          'themePreset',
          'language',
          'promptCount',
          'appBuildCount',
          'mediaGenCount',
          'updatedAt'
        ]);

      allow delete: if isVerified() && isOwner(userId) && isValidId(userId);

      // Isolated Per-User Projects Subcollection
      match /projects/{projectId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(projectId) && parentUserExists(userId);
        allow list: if isVerified() && isOwner(userId) && existing().ownerId == request.auth.uid;

        allow create: if isVerified() &&
          isOwner(userId) &&
          isValidId(userId) &&
          isValidId(projectId) &&
          isValidUserProject(incoming(), userId, projectId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          parentUserExists(userId);

        allow update: if isVerified() &&
          isOwner(userId) &&
          isValidId(userId) &&
          isValidId(projectId) &&
          isValidUserProject(incoming(), userId, projectId) &&
          incoming().id == existing().id &&
          incoming().ownerId == existing().ownerId &&
          incoming().numericId == existing().numericId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'idea', 'progress', 'status', 'updatedAt']) &&
          parentUserExists(userId);

        allow delete: if isVerified() && isOwner(userId) && isValidId(userId) && isValidId(projectId) && parentUserExists(userId);
      }

      // Isolated Per-User Conversations Subcollection
      match /conversations/{conversationId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(conversationId) && parentUserExists(userId);
        allow list: if isVerified() && isOwner(userId) && existing().ownerId == request.auth.uid;

        allow create: if isVerified() &&
          isOwner(userId) &&
          isValidId(userId) &&
          isValidId(conversationId) &&
          isValidUserConversation(incoming(), userId, conversationId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          parentUserExists(userId);

        allow update: if isVerified() &&
          isOwner(userId) &&
          isValidId(userId) &&
          isValidId(conversationId) &&
          isValidUserConversation(incoming(), userId, conversationId) &&
          incoming().id == existing().id &&
          incoming().ownerId == existing().ownerId &&
          incoming().numericId == existing().numericId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['projectId', 'title', 'lastMessagePreview', 'messageCount', 'updatedAt']) &&
          parentUserExists(userId);

        allow delete: if isVerified() && isOwner(userId) && isValidId(userId) && isValidId(conversationId) && parentUserExists(userId);
      }

      // Isolated Per-User Knowledge Documents Subcollection
      match /knowledge/{docId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(docId) && parentUserExists(userId);
        allow list: if isVerified() && isOwner(userId) && existing().ownerId == request.auth.uid;

        allow create: if isVerified() &&
          isOwner(userId) &&
          isValidId(userId) &&
          isValidId(docId) &&
          isValidUserKnowledgeDoc(incoming(), userId, docId) &&
          incoming().createdAt == request.time &&
          parentUserExists(userId);

        allow update: if false;

        allow delete: if isVerified() && isOwner(userId) && isValidId(userId) && isValidId(docId) && parentUserExists(userId);
      }

      // Isolated Per-User Generated Artifacts Subcollection
      match /artifacts/{artifactId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(artifactId) && parentUserExists(userId);
        allow list: if isVerified() && isOwner(userId) && existing().ownerId == request.auth.uid;

        allow create: if isVerified() &&
          isOwner(userId) &&
          isValidId(userId) &&
          isValidId(artifactId) &&
          isValidUserArtifact(incoming(), userId, artifactId) &&
          incoming().createdAt == request.time &&
          parentUserExists(userId);

        allow update: if false;

        allow delete: if isVerified() && isOwner(userId) && isValidId(userId) && isValidId(artifactId) && parentUserExists(userId);
      }
    }
  }
}
