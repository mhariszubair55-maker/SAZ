{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user profile, workspace settings, and usage counters stored per user.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Unique user identifier matching request.auth.uid.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Display name shown in the welcome hero and profile avatar.",
          "minLength": 1,
          "maxLength": 80
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User email address (PII, owner-restricted).",
          "maxLength": 120
        },
        "photoURL": {
          "type": "string",
          "description": "Optional avatar photo URL.",
          "maxLength": 500
        },
        "bio": {
          "type": "string",
          "description": "Optional developer bio or organization note.",
          "maxLength": 240
        },
        "roleTitle": {
          "type": "string",
          "description": "Optional developer role title.",
          "maxLength": 60
        },
        "provider": {
          "type": "string",
          "description": "Authentication provider used.",
          "enum": ["google", "github", "email"],
          "maxLength": 20
        },
        "themePreset": {
          "type": "string",
          "description": "Preferred UI theme preset.",
          "enum": ["neon_dark", "midnight_blue", "minimal_mono", "solar_light"],
          "maxLength": 30
        },
        "language": {
          "type": "string",
          "description": "Preferred assistant response language.",
          "enum": ["english", "urdu", "roman"],
          "maxLength": 20
        },
        "promptCount": {
          "type": "number",
          "description": "Total AI prompts executed by this user."
        },
        "appBuildCount": {
          "type": "number",
          "description": "Total interactive apps built by this user."
        },
        "mediaGenCount": {
          "type": "number",
          "description": "Total media assets generated by this user."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of initial profile creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of latest profile update."
        }
      },
      "required": ["uid", "displayName", "email", "provider", "createdAt", "updatedAt"]
    },
    "UserProject": {
      "title": "UserProject",
      "description": "Isolated project record owned by a specific user.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Project document identifier.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "description": "Owner UID matching request.auth.uid.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "numericId": {
          "type": "number",
          "description": "Numeric project ID used in workspace state."
        },
        "title": {
          "type": "string",
          "description": "Project title.",
          "minLength": 1,
          "maxLength": 120
        },
        "idea": {
          "type": "string",
          "description": "Project idea and specification.",
          "maxLength": 2000
        },
        "progress": {
          "type": "string",
          "description": "Latest execution progress note.",
          "maxLength": 1000
        },
        "status": {
          "type": "string",
          "description": "Project lifecycle status.",
          "enum": ["active", "paused", "complete"],
          "maxLength": 20
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update."
        }
      },
      "required": ["id", "ownerId", "numericId", "title", "idea", "progress", "status", "createdAt", "updatedAt"]
    },
    "UserConversation": {
      "title": "UserConversation",
      "description": "Isolated chat session and serialized message transcript owned by a specific user.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Conversation document identifier.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "description": "Owner UID matching request.auth.uid.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "numericId": {
          "type": "number",
          "description": "Numeric conversation ID."
        },
        "projectId": {
          "type": "number",
          "description": "Associated numeric project ID."
        },
        "title": {
          "type": "string",
          "description": "Conversation session title.",
          "minLength": 1,
          "maxLength": 140
        },
        "lastMessagePreview": {
          "type": "string",
          "description": "Preview of the latest message in the conversation.",
          "maxLength": 500
        },
        "messageCount": {
          "type": "number",
          "description": "Number of messages in this conversation."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update."
        }
      },
      "required": ["id", "ownerId", "numericId", "projectId", "title", "lastMessagePreview", "messageCount", "createdAt", "updatedAt"]
    },
    "UserKnowledgeDoc": {
      "title": "UserKnowledgeDoc",
      "description": "Isolated RAG knowledge document uploaded by a specific user.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Knowledge document identifier.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "description": "Owner UID matching request.auth.uid.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "numericId": {
          "type": "number",
          "description": "Numeric document ID."
        },
        "projectId": {
          "type": "number",
          "description": "Associated numeric project ID."
        },
        "name": {
          "type": "string",
          "description": "File name.",
          "minLength": 1,
          "maxLength": 160
        },
        "mimeType": {
          "type": "string",
          "description": "Document MIME type.",
          "maxLength": 100
        },
        "content": {
          "type": "string",
          "description": "Extracted text content for RAG indexing.",
          "maxLength": 100000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of upload."
        }
      },
      "required": ["id", "ownerId", "numericId", "projectId", "name", "mimeType", "content", "createdAt"]
    },
    "UserArtifact": {
      "title": "UserArtifact",
      "description": "Isolated generated app or media metadata owned by a specific user.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Artifact identifier.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "description": "Owner UID matching request.auth.uid.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "kind": {
          "type": "string",
          "description": "Artifact type.",
          "enum": ["app", "image", "video", "audio"],
          "maxLength": 20
        },
        "title": {
          "type": "string",
          "description": "Artifact title.",
          "minLength": 1,
          "maxLength": 160
        },
        "description": {
          "type": "string",
          "description": "Artifact summary or prompt.",
          "maxLength": 1000
        },
        "htmlCode": {
          "type": "string",
          "description": "Optional standalone HTML code for interactive app artifacts.",
          "maxLength": 150000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation."
        }
      },
      "required": ["id", "ownerId", "kind", "title", "description", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Stores isolated user profile, settings, and usage counters readable and writable only by the owner."
    },
    "/users/{userId}/projects/{projectId}": {
      "schema": "UserProject",
      "description": "Stores isolated user projects readable and writable only by the owner."
    },
    "/users/{userId}/conversations/{conversationId}": {
      "schema": "UserConversation",
      "description": "Stores isolated user chat sessions readable and writable only by the owner."
    },
    "/users/{userId}/knowledge/{docId}": {
      "schema": "UserKnowledgeDoc",
      "description": "Stores isolated user RAG knowledge documents readable and writable only by the owner."
    },
    "/users/{userId}/artifacts/{artifactId}": {
      "schema": "UserArtifact",
      "description": "Stores isolated user generated apps and media metadata readable and writable only by the owner."
    }
  }
}
