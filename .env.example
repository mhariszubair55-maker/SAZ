# ============================================================================
# SAZ AI · Production Environment Variables (.env.example)
# ============================================================================

# 1. Google Gemini / Imagen / Veo API Key (Server-Side Only — REQUIRED)
# Powers Chat, App Builder, Image Studio (Gemini 2.5 Flash Image / Imagen 3),
# Video Studio (Script Plan + Veo 3.1), and Multilingual TTS (Gemini 2.5 Flash TTS).
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# 2. Server & Application URL
PORT="3000"
NODE_ENV="production"
APP_URL="https://your-production-domain.run.app"

# 3. Admin & Multi-Tenant Governance
# Comma-separated list of admin emails granted access to /api/admin/subscription-config
SAZ_ADMIN_EMAILS="sheikhzubair554@gmail.com"

# 4. Modular Payment Gateway Integration (Optional — Stripe / LemonSqueezy / Paddle / Custom)
# Do NOT hard-code secret keys in code; set them via environment variables in production.
PAYMENT_PROVIDER="stripe"
PAYMENT_PUBLIC_KEY=""
PAYMENT_SECRET_KEY=""
PAYMENT_WEBHOOK_SECRET=""
STRIPE_PRICE_ID_PRO_MONTHLY=""
STRIPE_PRICE_ID_PRO_YEARLY=""
STRIPE_PRICE_ID_PREMIUM_MONTHLY=""
STRIPE_PRICE_ID_PREMIUM_YEARLY=""

# 5. Android / Capacitor Native Wrapper (Client-Side Optional Override)
VITE_SAZ_API_BASE_URL=""
